[run]
branch = True
# Only gate on production (non-test) modules. The scripts/test_*.py
# files are tests themselves; measuring them against a 100% floor
# would fail as soon as any test file gains an unreachable defensive
# branch. The modules listed below, however, are single-file
# supply-chain-critical helpers — a regression below 100% must fail CI.
#
#   * validate_formulae.py — the tap-side formula validator invoked by
#     .github/workflows/validate-formulae.yml (see #334).
#   * formula_parser.py — production-shared stanza regex / discovery
#     helpers (``FORMULA_DIR``, ``VERSION_LINE_RE``, ``URL_LINE_RE``,
#     ``load_formulae()``, ``list_formula_paths()``, etc.). Imported
#     directly by ``validate_formulae.py`` and by ~25
#     ``test_formula_*_invariants.py`` modules; a weakening here would
#     silently weaken every downstream invariant test that depends on
#     these regexes or the shared loader. Split out of
#     ``formula_test_fixtures.py`` in kubestellar/homebrew-tap#565.
#   * formula_test_fixtures.py — synthetic test-only Formula/*.rb
#     bodies (``VALID_OPS`` / ``VALID_DEPLOY``) plus backward-compatible
#     re-exports of the ``formula_parser`` symbols so the existing
#     ``test_formula_*_invariants.py`` import sites keep working
#     unchanged. Historically also held the parser symbols listed above
#     (see #328, #329, #450); kept on the 100% ratchet so the re-export
#     shim itself cannot silently rot.
#   * coverage_gate.py — the coverage gate helper itself, invoked by
#     .github/workflows/validate-formulae.yml. If this file silently
#     drops below 100%, a regression in the gate could allow the modules
#     above to drift below their ratchet without CI catching it. Guard
#     the guard.
include =
    scripts/validate_formulae.py
    scripts/formula_parser.py
    scripts/formula_test_fixtures.py
    scripts/coverage_gate.py

[report]
show_missing = True
skip_covered = False
# The `if __name__ == "__main__":` guard at the bottom of each helper
# is a standard entry-point shim exercised only by subprocess-level
# invocation (e.g. the CI step that runs the module directly). Unit
# tests invoke `main()` in-process, so these two lines are structurally
# unreachable from unittest discovery. Excluding them keeps the 100%
# ratchet honest instead of forcing a synthetic subprocess test whose
# only purpose is to touch the shim.
exclude_also =
    if __name__ == .__main__.:
