# Top-level development / CI dependencies for the validate-formulae unit
# tests + coverage gate. This is the human-edited input; requirements-dev.txt
# is the generated, hash-pinned lockfile that CI actually installs.
#
# Regenerate requirements-dev.txt after changing a pin here:
#
#   pip install pip-tools
#   scripts/compile_requirements_dev.sh
#
# The wrapper runs `pip-compile --generate-hashes --no-annotate --no-header`
# and automatically reapplies the explanatory header comment block at the
# top of requirements-dev.txt (pip-compile --no-header would otherwise
# drop it). Do not call pip-compile directly against requirements-dev.txt.
pytest==9.1.1
pytest-cov==7.1.0
coverage==7.16.1
